# Template for the per-environment env files. Copy, do not edit this one.
#
#   local -> .env.local   (your machine)
#   dev   -> .env.dev     (VPS, deployed from the `development` branch)
#   prod  -> .env.prod    (VPS, deployed from `master`)
#
# Only .env.example is committed. The filled-in files are gitignored - the VPS
# copies live on the VPS and nowhere else.
#
#   Windows:  Copy-Item .env.example .env.local
#   Linux:    cp .env.example .env.prod
#
# Run one with:  docker compose --env-file .env.dev up -d --build

# Which Spring profile the container boots: local | dev | prod
SPRING_PROFILES_ACTIVE=dev

# Isolates this environment's containers, network and volume from the others so
# dev and prod can share a VPS without touching each other's data.
#   dev -> superdive-dev     prod -> superdive-prod
COMPOSE_PROJECT_NAME=superdive-dev

# Host ports. Both are bound to 127.0.0.1 in docker-compose.yml, so nothing here
# is reachable from the internet - nginx on the VPS is what publishes the API.
# Give each environment its own pair or the second one will fail to start.
#   dev -> 8081 / 3307       prod -> 8080 / 3308
APP_HOST_PORT=8081
MYSQL_HOST_PORT=3307

# Database name and root password for the MySQL container. The backend connects
# with these too. Use a different password per environment.
MYSQL_DATABASE=superdive
MYSQL_ROOT_PASSWORD=change-me

# Base64, must decode to at least 32 bytes for HS256. Generate a fresh one per
# environment (a leaked dev token must not be valid in prod):
#   openssl rand -base64 48
JWT_SECRET=change-me

# Token validity in milliseconds (24 hours).
JWT_EXPIRATION=86400000

# The exact origin (scheme + host + port, no trailing slash) your frontend is
# served from. Browsers block requests from any other origin.
#   local -> http://localhost:3000
#   dev   -> https://dev.yourdomain.com
#   prod  -> https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=change-me

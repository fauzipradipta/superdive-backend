# Copy to .env and fill in. .env is gitignored — never commit real values.
#   Windows:  Copy-Item .env.example .env

# Root password for the MySQL container. Also used by the backend to connect.
MYSQL_ROOT_PASSWORD=change-me

# Base64, must decode to at least 32 bytes for HS256. Generate a fresh one with:
#   openssl rand -base64 48
JWT_SECRET=change-me

# Token validity in milliseconds (24 hours).
JWT_EXPIRATION=86400000

# The exact origin (scheme + host + port, no trailing slash) your frontend is
# served from. Browsers will block requests from any other origin.
#   e.g. https://app.yourdomain.com  or  http://<vps-ip>:3000
CORS_ALLOWED_ORIGINS=change-me

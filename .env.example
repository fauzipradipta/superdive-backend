# Copy to .env and fill in. .env is gitignored — never commit real values.
#   Windows:  Copy-Item .env.example .env

# Root password for the MySQL container. Also used by the backend to connect.
MYSQL_ROOT_PASSWORD=change-me

# Base64, must decode to at least 32 bytes for HS256. Generate a fresh one with:
#   openssl rand -base64 48
JWT_SECRET=change-me

# Token validity in milliseconds (24 hours).
JWT_EXPIRATION=86400000
